# Copia este archivo como ".env" (en esta misma carpeta) y ajusta los valores.

# Orígenes permitidos para el frontend (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Opcional: clave para firmar las sesiones. Si no la defines, se genera
# automáticamente en el archivo ".secret_key" (no lo subas a git).
# INVENTARIO_SECRET=

# ───────── Avisos de stock bajo por correo (opcional) ─────────
# Cuando un producto llega a su stock mínimo, se envía un correo.
# Ejemplo para Gmail (necesitas una "contraseña de aplicación", NO tu clave normal):
#   1) Activa la verificación en 2 pasos en tu cuenta de Google
#   2) Crea la contraseña en https://myaccount.google.com/apppasswords
#   3) Pégala abajo (16 letras, sin espacios)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop
# Opcional: quién recibe los avisos (varios separados por coma). Si no lo pones, llegan a SMTP_USER.
# ALERTAS_EMAIL_A=tucorreo@gmail.com,socio@gmail.com
# Opcional: remitente que se muestra
# SMTP_FROM=Inventario <tucorreo@gmail.com>
