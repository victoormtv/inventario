{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "backend": {
            "root": "backend",
            "entrypoint": "main.py"
        },
        "frontend": {
            "root": "frontend",
            "framework": "nextjs"
        }
    },
    "rewrites": [
        {
            "source": "/api/api/(.*)",
            "destination": {
                "service": "backend",
                "path": "/api/$1"
            }
        },
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}